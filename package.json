{
  "name": "the-sky-courier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --configLoader native --host 0.0.0.0",
    "build": "node node_modules/vite/bin/vite.js build --configLoader native && node scripts/cache.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview --configLoader native --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "prepare:alex": "node scripts/build-alex.mjs",
    "serve:phone": "node scripts/serve-phone.mjs",
    "package:phone": "npm run build && node scripts/package-phone.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.9"
  }
}
